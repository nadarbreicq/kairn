{
  "name": "kairn",
  "private": true,
  "description": "Kairn — application de suivi sportif hors ligne, et Kairn Desk, son poste de lecture sur ordinateur.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "oxlint .",
    "test": "npm run test --workspace packages/core && npm run test --workspace apps/desk && npm run test --workspace apps/mobile",
    "test:core": "npm run test --workspace packages/core",
    "test:desk": "npm run test --workspace apps/desk",
    "test:mobile": "npm run test --workspace apps/mobile",
    "build:core": "npm run build --workspace packages/core",
    "desk:dev": "npm run dev --workspace apps/desk",
    "mobile:start": "npm run start --workspace apps/mobile"
  },
  "devDependencies": {
    "oxlint": "^0.15.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
