{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Kairn Desk : déboguer le serveur",
      "program": "${workspaceFolder}/apps/desk/node_modules/.bin/tsx",
      "args": ["src/server.ts"],
      "cwd": "${workspaceFolder}/apps/desk",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Core : déboguer les tests",
      "program": "${workspaceFolder}/packages/core/node_modules/.bin/jest",
      "args": ["--runInBand"],
      "cwd": "${workspaceFolder}/packages/core",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Kairn Desk : déboguer les tests",
      "program": "${workspaceFolder}/apps/desk/node_modules/.bin/jest",
      "args": ["--runInBand"],
      "cwd": "${workspaceFolder}/apps/desk",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Mobile : ouvrir dans le navigateur (Expo web)",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}/apps/mobile",
      "preLaunchTask": "Mobile : démarrer (Expo)"
    }
  ]
}
