{
  "name": "@kairn/desk",
  "version": "0.1.0",
  "private": true,
  "description": "Kairn Desk — lit le dossier de sessions exporté par le téléphone et sert son interface sur localhost. Aucun compte, aucun serveur distant.",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "prebuild": "npm run build --workspace @kairn/core",
    "build": "tsc -p tsconfig.json",
    "predev": "npm run build --workspace @kairn/core",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "pretest": "npm run build --workspace @kairn/core",
    "test": "jest"
  },
  "dependencies": {
    "@kairn/core": "^0.1.0",
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
